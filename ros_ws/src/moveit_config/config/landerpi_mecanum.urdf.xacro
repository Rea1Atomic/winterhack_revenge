<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="landerpi_mecanum">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import landerpi_mecanum urdf file -->
    <xacro:include filename="$(find landerpi_description)/urdf/landerpi_mecanum.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="landerpi_mecanum.ros2_control.xacro" />


    <xacro:landerpi_mecanum_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
